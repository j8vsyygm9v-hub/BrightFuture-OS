        {
          "tid": "ielts_1",
          "title": "BBC 6 Minute English 精听",
          "time": "40 分钟",
          "hint": "听一遍、精听一遍，再记录5个高频表达。",
          "body": [
            {
              "type": "p",
              "html": "选择 BBC Learning English 最新一期 6 Minute English，完成精听。"
            },
            {
              "type": "ul",
              "items": [
                "第一遍：不看字幕理解大意",
                "第二遍：记录生词和表达",
                "第三遍：尝试复述核心内容"
              ]
            },
            {
              "type": "links",
              "items": [
                {
                  "text": "→ BBC Learning English",
                  "href": "https://www.bbc.co.uk/learningenglish"
                }
              ]
            }
          ]
        },
        {
          "tid": "ielts_2",
          "title": "影子跟读",
          "time": "10 分钟",
          "hint": "选择60—90秒材料进行跟读。",
          "body": [
            {
              "type": "p",
              "html": "选择今天精听材料中的一段，进行3遍 shadowing，模仿语音、节奏和连读。"
            }
          ]
        },
        {
          "tid": "ielts_3",
          "title": "雅思口语输出",
          "time": "10 分钟",
          "hint": "用今天学到的表达完成1分钟口述。",
          "body": [
            {
              "type": "p",
              "html": "任选一个雅思口语话题，使用今天至少3个新表达完成1分钟英文回答。"
            }
          ]
        }
      ]
    },

